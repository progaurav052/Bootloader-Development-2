#include "usart.h"

// we will use USART2 to connect to PC , VCOM support is present already


void usart2_init()
{
	//enable the peripheral clock
	RCC->APB1ENR |= ( 1<<17 );

	//2. configure the GPIO pins for USART_TX and USART_RX
	    // in our board USART2 peripheral provide virtual com support
	    // GPIO PA 2-TX , PA3-RX
		//First clear the bits

	// Before this enable the clock for GPIOA peripheral
	RCC->AHB1ENR &= ~(RCC_AHB1ENR_GPIOAEN);
	RCC->AHB1ENR |=  RCC_AHB1ENR_GPIOAEN;


	GPIOA->MODER &=~(0x3 << 4);
	GPIOA->MODER &=~(0x3 << 6);

	// configuring the alternate function
	GPIOA->MODER |=(0x2 << 4);
	GPIOA->MODER |=(0x2 << 6);

	//configure the AFRL / AFRH register accordingly
	//clear and set the AF7
	GPIOA->AFR[0] &= ~(0xF << 8);
	GPIOA->AFR[0] &= ~(0xF << 12);

	GPIOA->AFR[0] |= (0x7 << 8);
	GPIOA->AFR[0] |= (0x7 << 12);

	//o/p type is push pull by default

	//pu-pd setting -> enbale PUPD , TX and RX line are high
	// configure pull up resistor , for USART2,SPI,I2C both TX and RX line are High
	GPIOA->PUPDR &=~(0x1 << 4);
	GPIOA->PUPDR &=~(0x1 << 6);

	GPIOA->PUPDR |=(0x1 << 4);
	GPIOA->PUPDR |=(0x1 << 6);


	//3. configue the BaudRate --> for this we need oversampling rate
    // from the reference Manual see the Fractionl Baud Rate generation value for 16Mhz at 115200 bps
	USART2->BRR = 0x8B;

	//4. configure the mode , no_of_stop bits , partiy , HW_FLOW control etc , wordlen
		//<no configuration required here , default values used, wrd len is 8 bits , parity is disabled>
	// enable the TX engine , RX engine based on mode
	USART2->CR1 |=(0x1 << 3);
	USART2->CR1 |=(0x1 << 2);

	//5. finally enable the USART peripheral , after all configs
	USART2->CR1 |=(0x1 << 13);

}
